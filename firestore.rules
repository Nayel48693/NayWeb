rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /pedidos/{pedidoId} {
      allow create: if request.resource.data.keys().hasOnly([
        'nome', 'email', 'telefone', 'tipoNegocio', 'plano', 'mensagem',
        'estado', 'origem', 'notaInterna', 'criadoEm'
      ])
      && request.resource.data.nome is string
      && request.resource.data.email is string
      && request.resource.data.mensagem is string
      && request.resource.data.estado == 'novo'
      && request.resource.data.origem == 'site'
      && request.resource.data.notaInterna == '';
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /planos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /exemplos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /configuracoes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /estatisticas/visitas {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['total']) && request.resource.data.total == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total'])
        && request.resource.data.total == resource.data.total + 1;
      allow delete: if isAdmin();
    }
  }
}